# Database URL — SQLite for local dev, PostgreSQL for production
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ai_friend
DATABASE_URL=sqlite+aiosqlite:///./ai_friend.db

# LLM — DeepSeek endpoint (OpenAI-compatible). Flash is cheapest and fastest.
# Off-peak discount 50% applies 00:30–08:30 Beijing time.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=deepseek-chat

# Companion default name
COMPANION_NAME=小禾

# Access token required by every /api route. Leave empty to let the app
# generate one into .auth_token on first start (never written to logs).
AUTH_TOKEN=

# Optional: vision model for image/video understanding.
# Leave unset to reuse the main LLM endpoint; or configure an independent
# vision provider via the in-app settings page (e.g. GLM-4V).
VISION_MODEL=qwen-vl-plus

# Stress tests only: MOCK_LLM=true skips all external LLM calls.
# MOCK_LLM=false
